{
  "name": "durable-approval-workbench",
  "version": "1.0.0",
  "private": true,
  "description": "Switchboard: durable customer onboarding and human approvals.",
  "license": "MIT",
  "engines": {
    "node": ">=16.16 <17"
  },
  "scripts": {
    "test": "TS_NODE_TRANSPILE_ONLY=1 mocha -r ts-node/register \"tests/unit/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build --config vite.config.ts",
    "start": "node dist/src/server/main.js",
    "worker": "node dist/src/worker.js",
    "provisioner": "node dist/src/provisioner/main.js",
    "test:e2e": "playwright test",
    "test:integration": "TS_NODE_TRANSPILE_ONLY=1 mocha -r ts-node/register --timeout 120000 \"tests/integration/**/*.test.ts\""
  },
  "dependencies": {
    "@temporalio/client": "1.0.0",
    "@temporalio/worker": "1.0.0",
    "@temporalio/workflow": "1.0.0",
    "@temporalio/activity": "1.0.0",
    "express": "4.18.1",
    "jose": "4.8.3",
    "pg": "8.7.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "keycloak-js": "18.0.1"
  },
  "devDependencies": {
    "@temporalio/testing": "1.0.0",
    "typescript": "4.7.4",
    "ts-node": "10.9.1",
    "mocha": "10.0.0",
    "vite": "3.0.3",
    "@vitejs/plugin-react": "2.0.0",
    "@playwright/test": "1.24.1",
    "@types/node": "16.11.47",
    "@types/mocha": "9.1.1",
    "@types/express": "4.17.13",
    "@types/pg": "8.6.5",
    "@types/react": "18.0.15",
    "@types/react-dom": "18.0.6",
    "supertest": "6.2.4",
    "@types/supertest": "2.0.12"
  }
}
